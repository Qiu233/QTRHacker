private string GetLegalName(string name)
{
	string newName = name.Trim(' ', '_');
	if (newName.Length == 0)
		return name.Trim();
	return newName;
}

private string GetNewName(string name)
{
	string newName = GetLegalName(name);
	newName = newName[0].ToString().ToUpper() + newName.Substring(1);
	return newName;
}

