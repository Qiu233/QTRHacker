<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QTRHacker.Controls" xmlns:converters="clr-namespace:QTRHacker.Converters">
    <ControlTemplate x:Key="ItemSlotTemplate" TargetType="controls:ItemSlot">
        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{DynamicResource Theme.Border}">
            <Grid>
                <Border x:Name="PART_MaskBorder" CornerRadius="5" Background="{DynamicResource Theme.Wash}" Visibility="Hidden"/>
                <Image x:Name="PART_ItemImage" Source="{TemplateBinding ItemImageSource}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <TextBlock Text="{TemplateBinding ItemStack, Converter={x:Static converters:ItemStackToHintConverter.Instance}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3,0,4,2" FontSize="11" Foreground="{DynamicResource Theme.Text}"/>
                <Border x:Name="PART_Border" CornerRadius="5" BorderThickness="0" BorderBrush="{TemplateBinding SelectedBorderBrush}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PART_Border" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.Selection}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_MaskBorder" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="controls:ItemSlot">
        <Setter Property="Template" Value="{StaticResource ItemSlotTemplate}"/>
        <Setter Property="SelectedBorderBrush" Value="{DynamicResource Theme.Accent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
</ResourceDictionary>
