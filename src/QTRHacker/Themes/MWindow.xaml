<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QTRHacker.Controls" xmlns:converters="clr-namespace:QTRHacker.Converters">
    <BooleanToVisibilityConverter x:Key="CaptionVisibility"/>
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Secondary}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="MWindowTemplate" TargetType="controls:MWindow">
        <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource Theme.Border}" Background="{TemplateBinding Background}">
            <AdornerDecorator>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Background="{DynamicResource Theme.Navigation}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PART_TitleText" Text="{TemplateBinding Title}" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" Background="Transparent" Padding="16,0" VerticalAlignment="Stretch" TextTrimming="CharacterEllipsis" TextAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="LineHeight" Value="38"/>
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PART_MinimizeButton" Command="{x:Static SystemCommands.MinimizeWindowCommand}" Style="{StaticResource CaptionButton}" Visibility="{Binding MinimizeBox, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CaptionVisibility}}">
                                <Path Data="M 0 5 L 10 5" Stroke="{DynamicResource Theme.Secondary}" StrokeThickness="1"/>
                            </Button>
                            <Button x:Name="PART_CloseButton" Command="{x:Static SystemCommands.CloseWindowCommand}" Style="{StaticResource CaptionButton}">
                                <Path Data="M 1 1 L 9 9 M 9 1 L 1 9" Stroke="{DynamicResource Theme.Secondary}" StrokeThickness="1"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="PART_Content" Grid.Row="1" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ContentControl>
                </Grid>
            </AdornerDecorator>
        </Border>
    </ControlTemplate>
    <Style TargetType="controls:MWindow">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="MaxHeight" Value="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"/>
        <Setter Property="MaxWidth" Value="{Binding Width, Source={x:Static SystemParameters.WorkArea}}"/>
        <Setter Property="Template" Value="{StaticResource MWindowTemplate}"/>
    </Style>
</ResourceDictionary>
