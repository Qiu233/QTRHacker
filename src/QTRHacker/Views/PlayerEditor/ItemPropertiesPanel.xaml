<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:QTRHacker.Localization" xmlns:local="clr-namespace:QTRHacker.Views.PlayerEditor" xmlns:common="clr-namespace:QTRHacker.Common" x:Class="QTRHacker.Views.PlayerEditor.ItemPropertiesPanel">
    <ItemsControl ItemsSource="{Binding ItemPropertyDatum}" ItemTemplateSelector="{x:Static local:ItemPropertyTemplateSelector.Instance}" VerticalAlignment="Top">
        <ItemsControl.Resources>
            <DataTemplate x:Key="DataTemplate_TextBox">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Tip}" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}"/>
                    <TextBox Grid.Column="1" Padding="7,4" MinHeight="28" FontSize="12" VerticalAlignment="Center">
                        <TextBox.Text>
                            <Binding Path="Value" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True"/>
                        </TextBox.Text>
                    </TextBox>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DataTemplate_ComboBox">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Tip}" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                    <ComboBox Grid.Column="1" FontSize="12" MinHeight="28" ItemsSource="{Binding Source}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Value, Mode=TwoWay}"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DataTemplate_CheckBox">
                <CheckBox Content="{Binding Tip}" IsChecked="{Binding Value}" FontSize="12" MinHeight="34"/>
            </DataTemplate>
        </ItemsControl.Resources>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Margin" Value="4,0"/>
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
