<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:QTRHacker.Localization" xmlns:local="clr-namespace:QTRHacker.Views.PlayerEditor" xmlns:common="clr-namespace:QTRHacker.Common" x:Class="QTRHacker.Views.PlayerEditor.ItemSlotsEditor">
    <UserControl.Resources>
        <common:BindingProxy x:Key="proxy" Data="{Binding}"/>
    </UserControl.Resources>
    <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.22*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource QTRHacker.Card}" Padding="12,20" Margin="0,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <local:ItemSlotsGrid x:Name="ItemSlotsPanel" DataContext="{Binding ItemSlotsGridViewModel}" VerticalAlignment="Top">
                    <local:ItemSlotsGrid.ItemContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Localization UI.ViewInWiki}" Command="{Binding Data.ViewInWikiCommand, Source={StaticResource proxy}}"/>
                            <MenuItem Header="{l:Localization UI.Copy}" Command="{Binding Data.CopyCommand, Source={StaticResource proxy}}"/>
                            <MenuItem Header="{l:Localization UI.Paste}" Command="{Binding Data.PasteCommand, Source={StaticResource proxy}}"/>
                        </ContextMenu>
                    </local:ItemSlotsGrid.ItemContextMenu>
                </local:ItemSlotsGrid>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource QTRHacker.Card}" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:Localization UI.Properties}" Style="{StaticResource QTRHacker.SectionTitle}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <local:ItemPropertiesPanel x:Name="ItemPropertiesPanel" DataContext="{Binding ItemPropertiesPanelViewModel}" VerticalAlignment="Top"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Localization UI.Apply}" Command="{Binding ApplyItemDataCommand}" Style="{StaticResource QTRHacker.PrimaryButton}" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="{l:Localization UI.Initialize}" Command="{Binding InitItemDataCommand}" Margin="0,0,8,0"/>
            <Button Content="{l:Localization UI.Save}" Command="{Binding SaveInvCommand}" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="{l:Localization UI.Load}" Command="{Binding LoadInvCommand}" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="{l:Localization UI.Edit}" Command="{Binding EditCommand}" MinWidth="80"/>
        </WrapPanel>
    </Grid>
</UserControl>
