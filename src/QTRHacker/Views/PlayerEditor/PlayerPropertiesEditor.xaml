<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:QTRHacker.Localization" xmlns:local="clr-namespace:QTRHacker.Views.PlayerEditor" xmlns:common="clr-namespace:QTRHacker.Common" x:Class="QTRHacker.Views.PlayerEditor.PlayerPropertiesEditor">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource QTRHacker.Card}" Padding="20">
                <ItemsControl ItemsSource="{Binding Colors}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Grid.IsSharedSizeScope="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Tip, StringFormat={}{0}:}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                                <Rectangle Grid.Column="1" Width="22" Height="22" RadiusX="4" RadiusY="4" Stroke="{DynamicResource Theme.Border}" StrokeThickness="1">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding Color}"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Grid.Column="2" Text="#" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                                <TextBox Grid.Column="3" Text="{Binding ColorInput}" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource QTRHacker.Card}" Margin="20,0,0,0" VerticalAlignment="Top" Padding="20">
                <StackPanel>
                    <TextBlock Text="{l:Localization UI.Properties}" Style="{StaticResource QTRHacker.SectionTitle}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Localization UI.PlayerProperties.MaxLife}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                        <TextBox Grid.Column="1" Text="{Binding MaxLife}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Localization UI.PlayerProperties.MaxMana}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                        <TextBox Grid.Column="1" Text="{Binding MaxMana}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{l:Localization UI.Refresh}" Command="{Binding RefreshCommand}" MinWidth="90" Margin="0,0,8,0"/>
                <Button Content="{l:Localization UI.Apply}" Command="{Binding ApplyCommand}" MinWidth="90" Style="{StaticResource QTRHacker.PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
