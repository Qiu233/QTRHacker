<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QTRHacker.Controls" xmlns:l="clr-namespace:QTRHacker.Localization" xmlns:common="clr-namespace:QTRHacker.Views.Common" x:Class="QTRHacker.Views.PagePanels.MainPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Localization UI.MainPage}" Style="{StaticResource QTRHacker.PageTitle}"/>
        <Border Grid.Row="1" Style="{StaticResource QTRHacker.Card}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:Localization Tip.DragCrossToGame}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,20,18"/>
                    <Button x:Name="WikiButton" Content="Wiki" Click="WikiButton_Click" HorizontalAlignment="Left" MinWidth="100"/>
                </StackPanel>
                <!-- Keep the native Cross size and geometry matched to the system cursor while dragging. -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <controls:Cross x:Name="Cross" Foreground="{DynamicResource Theme.CrossForeground}" CrossReleased="Cross_CrossReleased" Visibility="{Binding CrossVisibility}"/>
                    <common:SpinnerDotCircle x:Name="LoadingSpinner" Visibility="{Binding SpinnerVisibility}"/>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource QTRHacker.Card}" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="{l:Localization UI.Properties}" Style="{StaticResource QTRHacker.SectionTitle}"/>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Players Array" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                    <TextBox Grid.Column="1" Text="{Binding PlayersArrayAddress}" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas" Background="Transparent" BorderThickness="0"/>
                    <Button Grid.Column="2" Content="{l:Localization UI.Edit}" Command="{Binding EditPlayersCommand}" MinWidth="74"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="My Player" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                    <TextBox Grid.Column="1" Text="{Binding MyPlayerAddress}" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas" Background="Transparent" BorderThickness="0"/>
                    <Button Grid.Column="2" Content="{l:Localization UI.Edit}" Command="{Binding EditMyPlayerCommand}" MinWidth="74"/>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NPCs Array" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}"/>
                    <TextBox Grid.Column="1" Text="{Binding NPCsArrayAddress}" IsReadOnly="True" IsReadOnlyCaretVisible="True" FontFamily="Consolas" Background="Transparent" BorderThickness="0"/>
                    <Button Grid.Column="2" Content="{l:Localization UI.Edit}" Command="{Binding EditNPCsCommand}" MinWidth="74"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
