<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QTRHacker.Controls" xmlns:l="clr-namespace:QTRHacker.Localization" xmlns:common="clr-namespace:QTRHacker.Views.Common" x:Class="QTRHacker.Views.PagePanels.PlayersPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Localization UI.Player}" Style="{StaticResource QTRHacker.PageTitle}"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="{l:Localization UI.Edit}" Command="{Binding EditPlayerCommand}" Margin="0,0,8,8" MinWidth="78" Style="{StaticResource QTRHacker.PrimaryButton}"/>
            <Button Content="{l:Localization UI.Edit_P}" Command="{Binding EditPlayerPropertyCommand}" Margin="0,0,8,8" MinWidth="78"/>
            <Button Content="{l:Localization UI.TPTo}" Command="{Binding TPToPlayerCommand}" Margin="0,0,8,8" MinWidth="78"/>
            <Button Content="{l:Localization UI.AddBuff}" Command="{Binding AddBuffCommand}" Margin="0,0,8,8" MinWidth="78"/>
            <Button Content="{l:Localization UI.SetPet}" Command="{Binding SetPetCommand}" Margin="0,0,8,8" MinWidth="78"/>
            <Button Content="{l:Localization UI.SetMount}" Command="{Binding SetMountCommand}" Margin="0,0,8,8" MinWidth="78"/>
        </WrapPanel>
        <Border Grid.Row="2" Style="{StaticResource QTRHacker.Card}" Padding="8">
            <common:PlayersListView DataContext="{Binding PlayersListViewViewModel}"/>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource QTRHacker.Card}" Margin="0,16,0,0" Padding="12,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="8,0">
                    <TextBlock Text="{l:Localization UI.Name}" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding InfoBoxName,Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="Transparent" BorderThickness="0" Padding="0" FontSize="18"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="{l:Localization UI.PlayerProperties.MaxLife}" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding InfoBoxMaxLife,Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="Transparent" BorderThickness="0" Padding="0" FontSize="18"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock Text="{l:Localization UI.PlayerProperties.MaxMana}" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding InfoBoxMaxMana,Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="Transparent" BorderThickness="0" Padding="0" FontSize="18"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="8,0">
                    <TextBlock Text="{l:Localization UI.PlayerProperties.X}" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding InfoBoxCoordinateX,Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="Transparent" BorderThickness="0" Padding="0" FontSize="18"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="8,0">
                    <TextBlock Text="{l:Localization UI.PlayerProperties.Y}" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding InfoBoxCoordinateY,Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Background="Transparent" BorderThickness="0" Padding="0" FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
