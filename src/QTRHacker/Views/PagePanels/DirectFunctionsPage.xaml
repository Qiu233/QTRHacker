<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QTRHacker.Controls" xmlns:l="clr-namespace:QTRHacker.Localization" x:Class="QTRHacker.Views.PagePanels.DirectFunctionsPage">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{l:Localization UI.DirectFunction}" Style="{StaticResource QTRHacker.PageTitle}"/>
        <Border Style="{StaticResource QTRHacker.Card}" Padding="6">
            <TabControl x:Name="FunctionsTab" TabStripPlacement="Left" ItemsSource="{Binding TabItems}" Background="Transparent" Padding="12,4"/>
        </Border>
    </DockPanel>
</UserControl>
