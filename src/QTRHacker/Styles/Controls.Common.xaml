<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QTRHacker.Controls">
    <Style TargetType="TextBlock"/>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Secondary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="QTRHacker.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>
    <Style x:Key="QTRHacker.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="QTRHacker.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.SubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="QTRHacker.TextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Error}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource QTRHacker.TextBoxStyle}"/>
    <Style x:Key="QTRHacker.WikiTextBoxStyleBase" TargetType="TextBox" BasedOn="{StaticResource QTRHacker.TextBoxStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Theme.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MaxWidth" Value="380"/>
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border CornerRadius="6" Background="{DynamicResource Theme.Panel}" BorderBrush="{DynamicResource Theme.SubtleBorder}" BorderThickness="1">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" TextElement.FontWeight="SemiBold" Margin="14,12,14,4"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FilterGroupBox" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}"/>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Theme.Secondary}" Background="{DynamicResource Theme.Input}" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M 3 8 L 7 12 L 14 4" Stroke="{DynamicResource Theme.AccentText}" StrokeThickness="1.8" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Mark" Property="Data" Value="M 4 8 L 12 8"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
