<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QTRHacker.Controls" xmlns:converters="clr-namespace:QTRHacker.Converters">
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Theme.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FirstColumn"/>
                            <ColumnDefinition x:Name="SecondColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="FirstRow" Height="Auto"/>
                            <RowDefinition x:Name="SecondRow"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Headers" Background="{DynamicResource Theme.Background}" Padding="4">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <Border x:Name="Body" Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="FirstColumn" Property="Width" Value="Auto"/>
                            <Setter TargetName="SecondColumn" Property="Width" Value="*"/>
                            <Setter TargetName="FirstRow" Property="Height" Value="*"/>
                            <Setter TargetName="SecondRow" Property="Height" Value="0"/>
                            <Setter TargetName="Body" Property="Grid.Row" Value="0"/>
                            <Setter TargetName="Body" Property="Grid.Column" Value="1"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="FirstColumn" Property="Width" Value="*"/>
                            <Setter TargetName="SecondColumn" Property="Width" Value="Auto"/>
                            <Setter TargetName="FirstRow" Property="Height" Value="*"/>
                            <Setter TargetName="SecondRow" Property="Height" Value="0"/>
                            <Setter TargetName="Headers" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="Body" Property="Grid.Row" Value="0"/>
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="FirstRow" Property="Height" Value="*"/>
                            <Setter TargetName="SecondRow" Property="Height" Value="Auto"/>
                            <Setter TargetName="Headers" Property="Grid.Row" Value="1"/>
                            <Setter TargetName="Body" Property="Grid.Row" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Secondary}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Surface" CornerRadius="5" Background="Transparent">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Margin="12,0" CornerRadius="1" Background="{DynamicResource Theme.Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Left">
                            <Setter TargetName="Indicator" Property="Width" Value="3"/>
                            <Setter TargetName="Indicator" Property="Height" Value="18"/>
                            <Setter TargetName="Indicator" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Center"/>
                            <Setter TargetName="Indicator" Property="Margin" Value="0"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
