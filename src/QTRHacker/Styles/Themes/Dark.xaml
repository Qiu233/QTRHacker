<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:QTRHacker.Controls">
    <SolidColorBrush x:Key="Theme.Background" Color="#202020"/>
    <SolidColorBrush x:Key="Theme.CrossForeground" Color="White"/>
    <SolidColorBrush x:Key="Theme.Navigation" Color="#191919"/>
    <SolidColorBrush x:Key="Theme.Panel" Color="#272727"/>
    <SolidColorBrush x:Key="Theme.Raised" Color="#323232"/>
    <SolidColorBrush x:Key="Theme.Input" Color="#303030"/>
    <SolidColorBrush x:Key="Theme.Hover" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Theme.Pressed" Color="#252525"/>
    <SolidColorBrush x:Key="Theme.Border" Color="#454545"/>
    <SolidColorBrush x:Key="Theme.SubtleBorder" Color="#353535"/>
    <SolidColorBrush x:Key="Theme.Text" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Theme.Secondary" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="Theme.Disabled" Color="#858585"/>
    <SolidColorBrush x:Key="Theme.Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Theme.AccentText" Color="#00354A"/>
    <SolidColorBrush x:Key="Theme.Selection" Color="#263F4B"/>
    <SolidColorBrush x:Key="Theme.Error" Color="#FF99A4"/>
    <SolidColorBrush x:Key="Theme.Wash" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="QTRHacker.Common.Foreground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="QTRHacker.Common.Foreground.Inverse" Color="#202020"/>
    <SolidColorBrush x:Key="QTRHacker.TextBox.Background" Color="#303030"/>
    <SolidColorBrush x:Key="QTRHacker.StripButton.Background" Color="#323232"/>
    <SolidColorBrush x:Key="QTRHacker.StripButton.BackMouseHover" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="QTRHacker.StripButton.BackMousePressed" Color="#252525"/>
    <SolidColorBrush x:Key="QTRHacker.StripButton.BackDisabled" Color="#272727"/>
    <SolidColorBrush x:Key="QTRHacker.StripButton.ForeDisabled" Color="#858585"/>
    <SolidColorBrush x:Key="QTRHacker.Light.Content.Foreground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="QTRHacker.Light.Tip.Foreground" Color="#B5B5B5"/>
    <SolidColorBrush x:Key="QTRHacker.Error" Color="#FF99A4"/>
    <SolidColorBrush x:Key="QTRHacker.SoftWhite" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TabItem.Background.Selected" Color="#263F4B"/>
    <SolidColorBrush x:Key="TabItem.Background" Color="#272727"/>
    <SolidColorBrush x:Key="TabControl.Background" Color="#202020"/>
    <SolidColorBrush x:Key="TabControl.Background.Header" Color="#202020"/>
    <SolidColorBrush x:Key="QTRHacker.Common.WhiteMusk.O20" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="QTRHacker.Common.WhiteMusk.O30" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="QTRHacker.Common.WhiteMusk.O40" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="QTRHacker.Common.WhiteMusk.O60" Color="#60FFFFFF"/>
    <SolidColorBrush x:Key="QTRHacker.Common.WhiteMusk.O80" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="QTRHacker.Common.WhiteMusk.OC0" Color="#C0FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#272727"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#303030"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#858585"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#263F4B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#263F4B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#272727"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F2F2"/>
    <Color x:Key="Theme.BackgroundColor">#202020</Color>
    <Color x:Key="Theme.NavigationColor">#191919</Color>
    <Color x:Key="Theme.PanelColor">#272727</Color>
    <Color x:Key="Theme.RaisedColor">#323232</Color>
    <Color x:Key="Theme.InputColor">#303030</Color>
    <Color x:Key="Theme.HoverColor">#3A3A3A</Color>
    <Color x:Key="Theme.PressedColor">#252525</Color>
    <Color x:Key="Theme.BorderColor">#454545</Color>
    <Color x:Key="Theme.SubtleBorderColor">#353535</Color>
    <Color x:Key="Theme.TextColor">#F2F2F2</Color>
    <Color x:Key="Theme.SecondaryColor">#B5B5B5</Color>
    <Color x:Key="Theme.DisabledColor">#858585</Color>
    <Color x:Key="Theme.AccentColor">#60CDFF</Color>
    <Color x:Key="Theme.AccentTextColor">#00354A</Color>
    <Color x:Key="Theme.SelectionColor">#263F4B</Color>
    <Color x:Key="Theme.ErrorColor">#FF99A4</Color>
    <Color x:Key="Theme.WashColor">#0DFFFFFF</Color>
</ResourceDictionary>
