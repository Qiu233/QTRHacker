<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<OutputType>Exe</OutputType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x86</PlatformTarget>
		<OutputPath>$(SolutionDir)bin\$(Configuration)\</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(DiagnosticAppHostSourcePath)' != ''">
		<AppHostSourcePath>$(DiagnosticAppHostSourcePath)</AppHostSourcePath>
		<AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
		<AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="ItemTarget\**\*.cs" />
		<ProjectReference Include="..\QHackLib\QHackLib.csproj" />
		<ProjectReference Include="..\QTRHacker.Core\QTRHacker.Core.csproj" />
		<ProjectReference Include="..\QTRHacker\QTRHacker.csproj" />
		<ProjectReference Include="..\QHackCLR.TestTarget\QHackCLR.TestTarget.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
	</ItemGroup>

	<!-- Publish only the diagnostic runner inside the EXE. Use the DLLs already
	     present in the customer's modifier directory, including mixed-mode QHackCLR. -->
	<Target Name="UseInstalledDiagnosticDependencies" BeforeTargets="_ComputeFilesToBundle"
			Condition="'$(PublishSingleFile)' == 'true'">
		<ItemGroup>
			<ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
					Condition="!$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('QTRHacker.Functions.Test.'))">
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<Import Project="..\..\build\LargeAddressAware.targets" />
</Project>
