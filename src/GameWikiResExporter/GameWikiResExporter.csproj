<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x86</PlatformTarget>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GameReferenceDirectory Condition="'$(GameReferenceDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\GameRefs</GameReferenceDirectory>
		<XnaAssemblyDirectory Condition="'$(XnaAssemblyDirectory)' == ''">$(WINDIR)\Microsoft.NET\assembly\GAC_32</XnaAssemblyDirectory>
	</PropertyGroup>

	<ItemGroup>
		<None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Terraria">
			<HintPath>$(GameReferenceDirectory)\Terraria.exe</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(MSBuildThisFileDirectory)..\..\GameRefs\Newtonsoft.Json.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.Xna.Framework">
			<HintPath>$(XnaAssemblyDirectory)\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.Xna.Framework.Game">
			<HintPath>$(XnaAssemblyDirectory)\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Microsoft.Xna.Framework.Graphics">
			<HintPath>$(XnaAssemblyDirectory)\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.IO.Compression.FileSystem" />
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

</Project>
